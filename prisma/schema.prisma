generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  CLIENT
  GATEKEEPER
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum ValidationResult {
  VALID
  INVALID
  ALREADY_USED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  eventsOrganized Event[]            @relation("OrganizerEvents")
  reservations    Reservation[]
  validations     TicketValidation[] @relation("GatekeeperValidations")
  tickets         Ticket[]           @relation("TicketOwner")
  sessions        Session[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())

  userId Int

  @@map("sessions")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  location    String
  capacity    Int
  soldCount   Int      @default(0)
  price       Decimal  @db.Decimal(10, 2)
  externalId  String

  organizerId Int
  organizer   User @relation("OrganizerEvents", fields: [organizerId], references: [id])

  reservations Reservation[]
  tickets      Ticket[]

  createdAt DateTime @default(now())

  @@map("events")
}

model Reservation {
  id        Int               @id @default(autoincrement())
  userId    Int
  eventId   Int
  quantity  Int
  status    ReservationStatus
  createdAt DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  payment Payment?
  tickets Ticket[]

  @@map("reservations")
}

model Payment {
  id            Int           @id @default(autoincrement())
  reservationId Int           @unique
  status        PaymentStatus
  amount        Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("payments")
}

model Ticket {
  id            Int          @id @default(autoincrement())
  reservationId Int
  eventId       Int
  ownerId       Int
  code          String       @unique
  shareToken    String       @unique @default(uuid())
  status        TicketStatus @default(VALID)

  createdAt DateTime @default(now())

  owner       User        @relation("TicketOwner", fields: [ownerId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])

  validations TicketValidation[]

  @@map("tickets")
}

model TicketValidation {
  id           Int              @id @default(autoincrement())
  ticketId     Int
  gatekeeperId Int
  result       ValidationResult
  createdAt    DateTime         @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  gatekeeper User   @relation("GatekeeperValidations", fields: [gatekeeperId], references: [id])

  @@map("ticket_validations")
}
